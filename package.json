{
	"name": "linked-data-python",
	"displayName": "Linked-Data Python",
	"description": "Linked-Data Python (.ldpy) : coloration, diagnostics, complétion, hover, définition (serveur LSP ldpy), exécution et débogage.",
	"icon": "ldpyIcon.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/linked-data-python/vscode-ldpy.git"
	},
	"homepage": "https://linked-data-python.readthedocs.io/",
	"bugs": {
		"url": "https://github.com/linked-data-python/vscode-ldpy/issues"
	},
	"qna": false,
	"keywords": [
		"rdf",
		"turtle",
		"sparql",
		"semantic web",
		"knowledge graph",
		"linked data",
		"ldpy"
	],
	"publisher": "MaximeLefrancois",
	"version": "0.2.1",
	"main": "./out/extension.js",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Formatters",
		"Linters"
	],
	"extensionDependencies": [],
	"extensionPack": [],
	"contributes": {
		"languages": [
			{
				"id": "ldpy",
				"aliases": [
					"Linked-Data Python",
					"ldpy"
				],
				"extensions": [
					".ldpy"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/rdf-file_icon-icons.com_71375.png",
					"dark": "./icons/rdf-file_icon-icons.com_71375.png"
				}
			}
		],
		"grammars": [
			{
				"language": "ldpy",
				"scopeName": "source.ldpy",
				"path": "./syntaxes/ldpy.tmLanguage.json"
			}
		],
		"breakpoints": [
			{
				"language": "ldpy"
			}
		],
		"debuggers": [
			{
				"type": "ldpy",
				"label": "Linked-Data Python",
				"languages": [
					"ldpy"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "Fichier .ldpy à déboguer.",
								"default": "${file}"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Arguments passés au script.",
								"default": []
							},
							"python": {
								"type": "string",
								"description": "Interpréteur Python portant le paquet ldpy (défaut : ldpy.pythonPath, sinon l'interpréteur actif de l'extension Python)."
							},
							"console": {
								"type": "string",
								"enum": [
									"integratedTerminal",
									"internalConsole",
									"externalTerminal"
								],
								"default": "integratedTerminal"
							},
							"justMyCode": {
								"type": "boolean",
								"default": true,
								"description": "Ne déboguer que le code utilisateur (masque le runtime ldpy installé)."
							},
							"cwd": {
								"type": "string",
								"description": "Répertoire de travail (défaut : celui du fichier)."
							},
							"env": {
								"type": "object",
								"description": "Variables d'environnement supplémentaires."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ldpy",
						"request": "launch",
						"name": "ldpy : fichier courant",
						"program": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "ldpy : déboguer le fichier courant",
						"description": "Débogue le fichier .ldpy ouvert (debugpy, breakpoints directement dans le .ldpy).",
						"body": {
							"type": "ldpy",
							"request": "launch",
							"name": "ldpy : fichier courant",
							"program": "^\"\\${file}\""
						}
					}
				]
			}
		],
		"commands": [
			{
				"command": "ldpy.run",
				"title": "Run File",
				"category": "ldpy",
				"icon": "$(play)"
			},
			{
				"command": "ldpy.debug",
				"title": "Debug File",
				"category": "ldpy",
				"icon": "$(debug-alt)"
			},
			{
				"command": "ldpy.showTranspiled",
				"title": "Show Transpiled Python",
				"category": "ldpy",
				"icon": "$(open-preview)"
			},
			{
				"command": "ldpy.formatWorkspace",
				"title": "Format All .ldpy Files in Workspace",
				"category": "ldpy"
			},
			{
				"command": "ldpy.setup",
				"title": "Set Up the Python Environment",
				"category": "ldpy",
				"icon": "$(tools)"
			},
			{
				"command": "ldpy.refresh",
				"title": "Check the Python Package Again",
				"category": "ldpy",
				"icon": "$(refresh)"
			},
			{
				"command": "ldpy.installPackage",
				"title": "Install or Update the linked-data-python Package",
				"category": "ldpy",
				"icon": "$(cloud-download)"
			},
			{
				"command": "ldpy.restartServer",
				"title": "Restart Language Server",
				"category": "ldpy"
			},
			{
				"command": "ldpy.showServerOutput",
				"title": "Show Language Server Log",
				"category": "ldpy"
			},
			{
				"command": "ldpy.selectInterpreter",
				"title": "Select Python Interpreter",
				"category": "ldpy"
			},
			{
				"command": "ldpy.openDocumentation",
				"title": "Open Documentation",
				"category": "ldpy"
			}
		],
		"configuration": {
			"title": "Linked-Data Python",
			"properties": {
				"ldpy.pythonPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"markdownDescription": "Interpréteur Python qui porte le paquet `linked-data-python` (serveur de langage, exécution, débogage, formatage). **Vide** = celui de l'extension Python, sinon `python3`. Un chemin absolu ne se synchronise pas entre machines."
				},
				"ldpy.backend": {
					"type": "string",
					"enum": [
						"pylsp",
						"none"
					],
					"enumDescriptions": [
						"Délègue complétion, définition et références à python-lsp-server.",
						"Couche native seule : diagnostics et coloration des îlots."
					],
					"default": "pylsp",
					"scope": "window",
					"description": "Serveur de langage Python auquel déléguer les questions qui portent sur le Python (request forwarding)."
				},
				"ldpy.buildDirectory": {
					"type": "string",
					"default": ".ldpy-build",
					"scope": "resource",
					"description": "Répertoire des fichiers Python générés (« Show Transpiled Python », ldpy build)."
				},
				"ldpy.lineLength": {
					"type": "number",
					"default": 88,
					"minimum": 40,
					"maximum": 320,
					"scope": "resource",
					"markdownDescription": "Longueur de ligne du formateur. Nécessite `pip install \"linked-data-python[format]\"`."
				},
				"ldpy.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"scope": "window",
					"description": "Trace les échanges avec le serveur de langage dans le canal « ldpy » — à activer pour un rapport de bug, pas au quotidien."
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "ldpy.run",
					"when": "editorLangId == ldpy"
				},
				{
					"command": "ldpy.debug",
					"when": "editorLangId == ldpy"
				},
				{
					"command": "ldpy.showTranspiled",
					"when": "editorLangId == ldpy"
				}
			],
			"editor/title/run": [
				{
					"command": "ldpy.run",
					"when": "editorLangId == ldpy",
					"group": "navigation@1"
				},
				{
					"command": "ldpy.debug",
					"when": "editorLangId == ldpy",
					"group": "navigation@2"
				}
			],
			"editor/title": [
				{
					"command": "ldpy.showTranspiled",
					"when": "editorLangId == ldpy",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "ldpy.run",
					"when": "editorLangId == ldpy",
					"group": "ldpy@1"
				},
				{
					"command": "ldpy.debug",
					"when": "editorLangId == ldpy",
					"group": "ldpy@2"
				},
				{
					"command": "ldpy.showTranspiled",
					"when": "editorLangId == ldpy",
					"group": "ldpy@3"
				}
			],
			"explorer/context": [
				{
					"command": "ldpy.run",
					"when": "resourceExtname == .ldpy",
					"group": "ldpy@1"
				}
			]
		}
	},
	"__metadata": {
		"id": "b33e9145-6168-4a63-9488-6eda27a08b1e",
		"publisherDisplayName": "Maxime Lefrançois",
		"publisherId": "32ad1cac-5cad-4c32-91dd-3e46ee2c592d",
		"isPreReleaseVersion": false
	},
	"activationEvents": [
		"onLanguage:ldpy",
		"onDebugResolve:ldpy",
		"onDebugDynamicConfigurations:ldpy"
	],
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"generate": "node syntaxes/generate.js",
		"test": "node test/parity.js && node test/contributes.js && node test/journeys.js",
		"lint": "tsc -p ./ --noEmit",
		"package": "npx --yes @vscode/vsce package",
		"publish": "npx --yes @vscode/vsce publish",
		"publish:ovsx": "npx --yes ovsx publish",
		"vscode:prepublish": "npm run compile && npm test"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.75.0",
		"linked-data-python-highlight": "git+https://github.com/linked-data-python/highlight-ldpy.git",
		"typescript": "^5.4.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.0.0"
	}
}
