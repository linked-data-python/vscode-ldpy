{
	"name": "linked-data-python",
	"displayName": "Linked-Data Python",
	"description": "Linked-Data Python (.ldpy) : coloration, diagnostics, complétion, hover, définition (serveur LSP ldpy), exécution et débogage.",
	"icon": "ldpyIcon.png",
	"repository": "gitlab:coswot/vscode-ldpy",
	"publisher": "MaximeLefrancois",
	"version": "0.2.0",
	"main": "./out/extension.js",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers"
	],
	"contributes": {
		"languages": [
			{
				"id": "ldpy",
				"aliases": [
					"Linked-Data Python",
					"ldpy"
				],
				"extensions": [
					".ldpy"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/rdf-file_icon-icons.com_71375.png",
					"dark": "./icons/rdf-file_icon-icons.com_71375.png"
				}
			}
		],
		"grammars": [
			{
				"language": "ldpy",
				"scopeName": "source.ldpy",
				"path": "./syntaxes/ldpy.tmLanguage.json"
			}
		],
		"breakpoints": [
			{
				"language": "ldpy"
			}
		],
		"debuggers": [
			{
				"type": "ldpy",
				"label": "Linked-Data Python",
				"languages": [
					"ldpy"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "Fichier .ldpy à déboguer.",
								"default": "${file}"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Arguments passés au script.",
								"default": []
							},
							"python": {
								"type": "string",
								"description": "Interpréteur Python portant le paquet ldpy (défaut : ldpy.pythonPath, sinon l'interpréteur actif de l'extension Python)."
							},
							"console": {
								"type": "string",
								"enum": [
									"integratedTerminal",
									"internalConsole",
									"externalTerminal"
								],
								"default": "integratedTerminal"
							},
							"justMyCode": {
								"type": "boolean",
								"default": true,
								"description": "Ne déboguer que le code utilisateur (masque le runtime ldpy installé)."
							},
							"cwd": {
								"type": "string",
								"description": "Répertoire de travail (défaut : celui du fichier)."
							},
							"env": {
								"type": "object",
								"description": "Variables d'environnement supplémentaires."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ldpy",
						"request": "launch",
						"name": "ldpy : fichier courant",
						"program": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "ldpy : déboguer le fichier courant",
						"description": "Débogue le fichier .ldpy ouvert (debugpy, breakpoints directement dans le .ldpy).",
						"body": {
							"type": "ldpy",
							"request": "launch",
							"name": "ldpy : fichier courant",
							"program": "^\"\\${file}\""
						}
					}
				]
			}
		],
		"commands": [
			{
				"command": "ldpy.run",
				"title": "ldpy: Run current file"
			},
			{
				"command": "ldpy.debug",
				"title": "ldpy: Debug current file (shadow)"
			},
			{
				"command": "ldpy.showShadow",
				"title": "ldpy: Show transpiled Python (shadow)"
			},
			{
				"command": "ldpy.restartServer",
				"title": "ldpy: Restart language server"
			}
		],
		"configuration": {
			"title": "Linked-Data Python",
			"properties": {
				"ldpy.pythonPath": {
					"type": "string",
					"default": "python3",
					"description": "Interpréteur Python qui porte le paquet ldpy (serveur LSP, build, debug)."
				},
				"ldpy.backend": {
					"type": "string",
					"enum": [
						"pylsp",
						"none"
					],
					"default": "pylsp",
					"description": "Serveur LSP Python délégué pour la complétion/définition (request forwarding)."
				},
				"ldpy.buildDirectory": {
					"type": "string",
					"default": ".ldpy-build",
					"description": "Répertoire des fichiers Python fantômes (build/debug)."
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "ldpy.run",
					"when": "editorLangId == ldpy"
				},
				{
					"command": "ldpy.debug",
					"when": "editorLangId == ldpy"
				},
				{
					"command": "ldpy.showShadow",
					"when": "editorLangId == ldpy"
				}
			]
		}
	},
	"__metadata": {
		"id": "b33e9145-6168-4a63-9488-6eda27a08b1e",
		"publisherDisplayName": "Maxime Lefrançois",
		"publisherId": "32ad1cac-5cad-4c32-91dd-3e46ee2c592d",
		"isPreReleaseVersion": false
	},
	"activationEvents": [
		"onLanguage:ldpy",
		"onDebugResolve:ldpy",
		"onDebugDynamicConfigurations:ldpy"
	],
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"generate": "node syntaxes/generate.js",
		"test": "node test/parity.js",
		"vscode:prepublish": "npm run compile"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.75.0",
		"typescript": "^5.4.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.0.0"
	}
}